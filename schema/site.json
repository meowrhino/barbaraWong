{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "data/site.json: la web",
  "description": "data/site.json: lo general de la web y qué proyectos salen, en qué orden. VS Code lee este fichero (por el \"$schema\" de arriba del JSON) para autocompletar, explicar cada campo y subrayar lo que está mal; el build y la vista previa lo usan para revisar.",
  "type": "object",
  "required": [
    "title",
    "languages",
    "menu",
    "welcome",
    "lists"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "pattern": "^https://",
      "description": "El dominio, sin barra al final: \"https://barbarawong.info\". Con él, Google indexa la web."
    },
    "title": {
      "type": "string",
      "description": "El nombre de la web: en la pestaña y al compartir."
    },
    "languages": {
      "type": "array",
      "items": {
        "enum": [
          "es",
          "en",
          "ca"
        ]
      },
      "description": "Los idiomas; el primero es el de por defecto."
    },
    "menu": {
      "type": "array",
      "description": "El menú, en orden.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label"
        ],
        "properties": {
          "key": {
            "enum": [
              "news",
              "works",
              "publications",
              "photos",
              "about",
              "contact"
            ],
            "description": "La sección."
          },
          "label": {
            "description": "Lo que pone en el menú.",
            "anyOf": [
              {
                "type": "string",
                "description": "El mismo en los tres idiomas."
              },
              {
                "type": "object",
                "additionalProperties": false,
                "description": "Uno por idioma: { \"es\": …, \"en\": …, \"ca\": … }",
                "properties": {
                  "es": {
                    "type": "string",
                    "description": "En castellano."
                  },
                  "en": {
                    "type": "string",
                    "description": "En inglés."
                  },
                  "ca": {
                    "type": "string",
                    "description": "En catalán."
                  }
                }
              }
            ]
          }
        }
      }
    },
    "welcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "videos"
      ],
      "description": "La portada: los vídeos de data/_welcome/.",
      "properties": {
        "videos": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "El nombre del vídeo sin extensión: \"1\" es data/_welcome/1.webm"
              },
              "label": {
                "type": "string",
                "description": "Lo que pone en su botón: \"01\""
              }
            }
          }
        },
        "formats": {
          "type": "array",
          "items": {
            "enum": [
              "webm",
              "mp4"
            ]
          },
          "description": "En qué formatos está cada vídeo."
        }
      }
    },
    "lists": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "works"
      ],
      "properties": {
        "works": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "description": "Los proyectos, en el orden del menú: el nombre de su carpeta en projects/."
        }
      }
    }
  }
}
