{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "projects/<nombre>/project.json: un proyecto",
  "description": "projects/<nombre>/project.json: un proyecto. Sus fotos, en la misma carpeta (o en subcarpetas), cada una con su nombre. VS Code lee este fichero (por el \"$schema\" de arriba del JSON) para autocompletar, explicar cada campo y subrayar lo que está mal; el build y la vista previa lo usan para revisar.",
  "type": "object",
  "required": [
    "title"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_": {
      "type": "string"
    },
    "title": {
      "description": "El título. <br> para partirlo en dos líneas.",
      "anyOf": [
        {
          "type": "string",
          "description": "El mismo en los tres idiomas."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "description": "Uno por idioma: { \"es\": …, \"en\": …, \"ca\": … }",
          "properties": {
            "es": {
              "type": "string",
              "description": "En castellano."
            },
            "en": {
              "type": "string",
              "description": "En inglés."
            },
            "ca": {
              "type": "string",
              "description": "En catalán."
            }
          }
        }
      ]
    },
    "visible": {
      "type": "boolean",
      "description": "false: sale en el menú en gris, \"próximamente\", sin página. Sin este campo, sale."
    },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "description": "La línea de debajo del título.",
      "properties": {
        "year": {
          "type": "string",
          "description": "\"2026\""
        },
        "type": {
          "description": "\"Film, 16mm a digital\"",
          "anyOf": [
            {
              "type": "string",
              "description": "El mismo en los tres idiomas."
            },
            {
              "type": "object",
              "additionalProperties": false,
              "description": "Uno por idioma: { \"es\": …, \"en\": …, \"ca\": … }",
              "properties": {
                "es": {
                  "type": "string",
                  "description": "En castellano."
                },
                "en": {
                  "type": "string",
                  "description": "En inglés."
                },
                "ca": {
                  "type": "string",
                  "description": "En catalán."
                }
              }
            }
          ]
        },
        "duration": {
          "type": "string",
          "description": "\"14:34 min\""
        }
      }
    },
    "text": {
      "description": "El texto. Un párrafo por línea de la lista. **negrita**, *cursiva* y <br> para saltar de línea.",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "El mismo en los tres idiomas."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "description": "Uno por idioma: { \"es\": …, \"en\": …, \"ca\": … }",
          "properties": {
            "es": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "En castellano."
            },
            "en": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "En inglés."
            },
            "ca": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "En catalán."
            }
          }
        }
      ]
    },
    "more": {
      "description": "El texto que se abre con \"ver más\". Un párrafo por línea de la lista. **negrita**, *cursiva* y <br> para saltar de línea.",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "El mismo en los tres idiomas."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "description": "Uno por idioma: { \"es\": …, \"en\": …, \"ca\": … }",
          "properties": {
            "es": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "En castellano."
            },
            "en": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "En inglés."
            },
            "ca": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "En catalán."
            }
          }
        }
      ]
    },
    "links": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 2,
            "description": "[\"el texto\", \"https://…\"]"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url"
            ],
            "description": "{ \"label\": \"el texto\" (o uno por idioma), \"url\": \"https://…\" }",
            "properties": {
              "label": {
                "description": "El texto del enlace.",
                "anyOf": [
                  {
                    "type": "string",
                    "description": "El mismo en los tres idiomas."
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "description": "Uno por idioma: { \"es\": …, \"en\": …, \"ca\": … }",
                    "properties": {
                      "es": {
                        "type": "string",
                        "description": "En castellano."
                      },
                      "en": {
                        "type": "string",
                        "description": "En inglés."
                      },
                      "ca": {
                        "type": "string",
                        "description": "En catalán."
                      }
                    }
                  }
                ]
              },
              "url": {
                "type": "string"
              }
            }
          }
        ]
      },
      "description": "Los enlaces, en orden. Uno de vimeo.com/showcase sale como botón."
    },
    "trailer": {
      "type": "string",
      "description": "El tráiler, en Vimeo: \"https://vimeo.com/…\""
    },
    "video": {
      "type": "string",
      "description": "Lo mismo que trailer (si no hay trailer)."
    },
    "trailer_pos": {
      "enum": [
        "antes",
        "pre",
        "despues"
      ],
      "description": "\"antes\": el tráiler sale antes de las fotos (si no, después)."
    },
    "videos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Más vídeos de Vimeo, antes de las fotos."
    },
    "credits": {
      "description": "Los créditos. Un párrafo por línea de la lista. **negrita**, *cursiva* y <br> para saltar de línea.",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "El mismo en los tres idiomas."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "description": "Uno por idioma: { \"es\": …, \"en\": …, \"ca\": … }",
          "properties": {
            "es": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "En castellano."
            },
            "en": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "En inglés."
            },
            "ca": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "En catalán."
            }
          }
        }
      ]
    },
    "groups": {
      "type": "array",
      "description": "Las galerías, en orden.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "photos"
        ],
        "properties": {
          "title": {
            "description": "El título de la galería: \"fotogramas\"",
            "anyOf": [
              {
                "type": "string",
                "description": "El mismo en los tres idiomas."
              },
              {
                "type": "object",
                "additionalProperties": false,
                "description": "Uno por idioma: { \"es\": …, \"en\": …, \"ca\": … }",
                "properties": {
                  "es": {
                    "type": "string",
                    "description": "En castellano."
                  },
                  "en": {
                    "type": "string",
                    "description": "En inglés."
                  },
                  "ca": {
                    "type": "string",
                    "description": "En catalán."
                  }
                }
              }
            ]
          },
          "photos": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Las fotos, desde la carpeta del proyecto: [\"fotogramas/001.webp\", \"posterVERTICAL.webp\"]. Con VERTICAL en el nombre sale más estrecha."
          }
        }
      }
    }
  }
}
