{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "data/about.json: sobre y contacto",
  "description": "data/about.json: las páginas \"sobre\" y \"contacto\". VS Code lee este fichero (por el \"$schema\" de arriba del JSON) para autocompletar, explicar cada campo y subrayar lo que está mal; el build y la vista previa lo usan para revisar.",
  "type": "object",
  "required": [
    "bio"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_": {
      "type": "string"
    },
    "bio": {
      "description": "La bio. Un párrafo por línea de la lista. **negrita**, *cursiva* y <br> para saltar de línea.",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "El mismo en los tres idiomas."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "description": "Uno por idioma: { \"es\": …, \"en\": …, \"ca\": … }",
          "properties": {
            "es": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "En castellano."
            },
            "en": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "En inglés."
            },
            "ca": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "En catalán."
            }
          }
        }
      ]
    },
    "image": {
      "type": "string",
      "description": "La foto: \"data/_news/076.webp\""
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "email": {
          "type": "string",
          "description": "El correo, como se ve: \"b.sanch.b [@] gmail.com\""
        },
        "instagram": {
          "type": "string"
        },
        "instagram_url": {
          "type": "string"
        },
        "image": {
          "type": "string",
          "description": "La foto: \"data/_news/076.webp\""
        }
      }
    }
  }
}
